rules_version = '2';

// Zugriff nur für angemeldete Nutzer, deren E-Mail (kleingeschrieben) als Dokument
// in der Sammlung "members" angelegt ist. Mitglieder werden in der Firebase-Konsole gepflegt.
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email.lower()));
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    match /members/{email} {
      allow read: if isMember();
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read, write: if isMember();

      // Kommentare & Verlauf: nur im eigenen Namen schreiben, nicht nachträglich ändern
      match /activity/{entryId} {
        allow read, delete: if isMember();
        allow create: if isMember() && request.resource.data.by == myEmail();
        allow update: if false;
      }
    }

    // Gemeinsame Einstellungen (Checklisten-Vorlagen, Geräte, Wind-Warnschwelle)
    match /settings/{docId} {
      allow read, write: if isMember();
    }
  }
}
